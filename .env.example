# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (MySQL)
DB_NAME=cyonApi
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=5h
BCRYPT_SALT_ROUNDS=12

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,https://cyonadclagos.org

# Uploads (optional overrides)
MAX_UPLOAD_BYTES=5242880
